# --------------------- INITIALIZAITION ---------------------

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
units		metal
dimension	3
boundary	p p p
atom_style	atomic
variable a0 equal 4.04999918095267

timestep 0.001


variable x_displace equal 1*(${a0}/sqrt(6))
variable x_displace equal 1*(4.04999918095267/sqrt(6))
variable x_displace2 equal -(${a0}/sqrt(6))
variable x_displace2 equal -(4.04999918095267/sqrt(6))


variable xdim equal ${a0}*sqrt(6)/2*10
variable xdim equal 4.04999918095267*sqrt(6)/2*10
variable ydim equal ${a0}*sqrt(2)/2*15
variable ydim equal 4.04999918095267*sqrt(2)/2*15
variable zdim equal ${a0}*sqrt(3)*8
variable zdim equal 4.04999918095267*sqrt(3)*8

# --------------------- CRYSTAL STRUCTURE DEFINITION ---------------------


lattice fcc ${a0}  orient x 1 1 2 orient y -1 1 0 orient z -1 -1 1
lattice fcc 4.04999918095267  orient x 1 1 2 orient y -1 1 0 orient z -1 -1 1
Lattice spacing in x,y,z = 6.613621 5.7275638 7.0148044

region		box block 0 ${xdim} 0 ${ydim} 0 ${zdim} units box
region		box block 0 49.6021572601192 0 ${ydim} 0 ${zdim} units box
region		box block 0 49.6021572601192 0 42.956728269774 0 ${zdim} units box
region		box block 0 49.6021572601192 0 42.956728269774 0 56.1184348161789 units box
create_box	1 box
Created orthogonal box = (0 0 0) to (49.602157 42.956728 56.118435)
  1 by 1 by 1 MPI processor grid
create_atoms	1 box
Created 7200 atoms
  using lattice units in orthogonal box = (0 0 0) to (49.602157 42.956728 56.118435)
  create_atoms CPU = 0.001 seconds

# --------------------- MEAM POTENTIAL ---------------------

pair_style hybrid/overlay tabgap eam/fs
pair_coeff * * tabgap Al.tabgap Al no yes
Reading tabgap potential file Al.tabgap with DATE: 2024-02-04
pair_coeff * * eam/fs Al.eam.fs Al
Reading eam/fs potential file Al.eam.fs with DATE: 2024-02-04

neighbor 0.5 bin
neigh_modify once no every 1 delay 0 check yes

pair_modify shift yes


#pair_style meam/c
#pair_coeff * * library-Al.meam Al Al.meam Al


write_data initial.lmp
System init for write_data ...
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 5.7
  ghost atom cutoff = 5.7
  binsize = 2.85, bins = 18 16 20
  2 neighbor lists, perpetual/occasional/extra = 2 0 0
  (1) pair tabgap, perpetual
      attributes: full, newton on
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
  (2) pair eam/fs, perpetual, half/full from (1)
      attributes: half, newton on, cut 5.7
      pair build: halffull/newton
      stencil: none
      bin: none

# --------------------- SETTINGS ---------------------

variable zmax equal ${zdim}+5
variable zmax equal 56.1184348161789+5
variable zmin equal -5


compute peratom all pe/atom
#compute eatoms all reduce sum c_peratom

thermo 10

#thermo_style custom step temp pe etotal press vol cpuremain

#thermo_style custom step pe c_eatoms

#dump 1 all custom 1 dump.relax.1.* id type xs ys zs c_peratom
#run 0

min_style cg
fix 5 all box/relax x 0.0 y 0.0
minimize 0.0 1e-6 100000 100000 #etol is relative
