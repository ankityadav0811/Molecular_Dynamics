# Calculate intrinsic stacking fault energy
variable Efinal equal pe
variable Ef equal ${Efinal}
variable Ef equal -16656.0641779098

# Conversion: eV/A^2 to mJ/m^2
variable area equal v_lx*v_ly
variable SFE equal (v_Ef-v_E0)*16021.76634/v_area

print "Reference energy = ${E0} eV"
