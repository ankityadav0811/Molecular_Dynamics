# --------------------- INITIALIZAITION ---------------------

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
units		metal
dimension	3
boundary	p p p
atom_style	atomic
variable a0 equal 4.0500046559292935

timestep 0.001


variable x_displace equal 1*(${a0}/sqrt(6))
variable x_displace equal 1*(4.05000465592929/sqrt(6))
variable x_displace2 equal -(${a0}/sqrt(6))
variable x_displace2 equal -(4.05000465592929/sqrt(6))


variable xdim equal ${a0}*sqrt(6)/2*10
variable xdim equal 4.05000465592929*sqrt(6)/2*10
variable ydim equal ${a0}*sqrt(2)/2*15
variable ydim equal 4.05000465592929*sqrt(2)/2*15
variable zdim equal ${a0}*sqrt(3)*8
variable zdim equal 4.05000465592929*sqrt(3)*8

# --------------------- CRYSTAL STRUCTURE DEFINITION ---------------------


lattice fcc ${a0}  orient x 1 1 2 orient y -1 1 0 orient z -1 -1 1
lattice fcc 4.05000465592929  orient x 1 1 2 orient y -1 1 0 orient z -1 -1 1
Lattice spacing in x,y,z = 6.6136299 5.7275715 7.0148138

region		box block 0 ${xdim} 0 ${ydim} 0 ${zdim} units box
region		box block 0 49.6022243146145 0 ${ydim} 0 ${zdim} units box
region		box block 0 49.6022243146145 0 42.9567863406704 0 ${zdim} units box
region		box block 0 49.6022243146145 0 42.9567863406704 0 56.1185106796803 units box
create_box	1 box
