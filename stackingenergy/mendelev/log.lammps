# --------------------- INITIALIZAITION ---------------------

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
units		metal
dimension	3
boundary	p p p
atom_style	atomic
variable a0 equal 4.045270459463278

timestep 0.001


variable x_displace equal 1*(${a0}/sqrt(6))
variable x_displace equal 1*(4.04527045946328/sqrt(6))
variable x_displace2 equal -(${a0}/sqrt(6))
variable x_displace2 equal -(4.04527045946328/sqrt(6))


variable xdim equal ${a0}*sqrt(6)/2*10
variable xdim equal 4.04527045946328*sqrt(6)/2*10
variable ydim equal ${a0}*sqrt(2)/2*15
variable ydim equal 4.04527045946328*sqrt(2)/2*15
variable zdim equal ${a0}*sqrt(3)*8
variable zdim equal 4.04527045946328*sqrt(3)*8

# --------------------- CRYSTAL STRUCTURE DEFINITION ---------------------


lattice fcc ${a0}  orient x 1 1 2 orient y -1 1 0 orient z -1 -1 1
lattice fcc 4.04527045946328  orient x 1 1 2 orient y -1 1 0 orient z -1 -1 1
Lattice spacing in x,y,z = 6.605899 5.7208763 7.006614

region		box block 0 ${xdim} 0 ${ydim} 0 ${zdim} units box
region		box block 0 49.5442424861955 0 ${ydim} 0 ${zdim} units box
region		box block 0 49.5442424861955 0 42.9065726043016 0 ${zdim} units box
region		box block 0 49.5442424861955 0 42.9065726043016 0 56.0529117291832 units box
create_box	1 box
Created orthogonal box = (0 0 0) to (49.544242 42.906573 56.052912)
  2 by 1 by 2 MPI processor grid
create_atoms	1 box
Created 7200 atoms
  using lattice units in orthogonal box = (0 0 0) to (49.544242 42.906573 56.052912)
  create_atoms CPU = 0.001 seconds

# --------------------- EAM POTENTIAL ---------------------

pair_style	eam/fs
pair_coeff * * Al-Mg.eam.fs Al

write_data initial.lmp
System init for write_data ...
Neighbor list info ...
  update every 1 steps, delay 10 steps, check yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 9.5
  ghost atom cutoff = 9.5
  binsize = 4.75, bins = 11 10 12
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair eam/fs, perpetual
      attributes: half, newton on
      pair build: half/bin/atomonly/newton
      stencil: half/bin/3d
      bin: standard

# --------------------- SETTINGS ---------------------

variable zmax equal ${zdim}+5
variable zmax equal 56.0529117291832+5
variable zmin equal -5


compute peratom all pe/atom
